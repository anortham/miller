<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Miller.Server</RootNamespace>
    <AssemblyName>miller</AssemblyName>
  </PropertyGroup>

  <!-- Serilog 4.3 emits an internal Native AOT trim warning from its destructuring converter. Miller does not use
       destructuring log templates, and we keep the suppression scoped to AOT publish so normal builds remain strict
       and Miller-owned trim/AOT warnings still fail release packaging. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Miller.Tests" />
  </ItemGroup>

  <!-- The MCP server-level agent instructions (behavioral-adoption guidance) shipped INSIDE the binary, so the
       server always has them regardless of cwd. Read at startup and set as McpServerOptions.ServerInstructions
       (see Program.cs). Mirrors julie's include_str! of JULIE_AGENT_INSTRUCTIONS.md. -->
  <ItemGroup>
    <EmbeddedResource Include="MILLER_AGENT_INSTRUCTIONS.md" />
  </ItemGroup>

  <!-- The routing block `miller rules` prints, shipped INSIDE the binary: a release archive has no repo
       checkout, so the verb must not read hooks/ from disk. LogicalName is explicit because the source file
       lives outside the project directory, where the derived resource name would encode the relative path. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../hooks/miller-routing-block.md"
                      LogicalName="Miller.Server.miller-routing-block.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <!-- The telemetry ledger (Miller-owned, writable telemetry.db) lives in Miller.Server. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- The machine-readable JSONL sink's compact formatter (M8 §D5). Referenced explicitly rather than relied on
         transitively via Serilog.Sinks.File so the M9 log-viewer input never depends on a transitive accident. -->
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Miller.Core\Miller.Core.csproj" />
    <ProjectReference Include="..\Miller.Indexing\Miller.Indexing.csproj" />
    <ProjectReference Include="..\Miller.Testing\Miller.Testing.csproj" />
  </ItemGroup>

  <!-- The pinned julie-extract is restored (gitignored) to the repo-root .tools/ by the restore scripts.
       Production locates it at AppContext.BaseDirectory/.tools (WorkspaceContext.ToolsRoot), so it must sit next to
       the built binary — the claim that it "ships under the app base dir" is only true because of this copy. Link
       places it at <out>/.tools/julie-extract[.exe]; PreserveNewest skips the recopy when unchanged; `dotnet publish`
       picks it up too. Conditioned on Exists so a machine that has not run restore (e.g. a fast-suite-only CI lane)
       still builds — the runtime then fails loudly with the restore-script message, the correct behavior for a
       genuinely missing binary. The exec bit is reasserted below for the Unix binary (MSBuild Copy drops it). -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../.tools/julie-extract')">
    <Content Include="$(MSBuildProjectDirectory)/../../.tools/julie-extract">
      <Link>.tools/julie-extract</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../.tools/julie-extract.exe')">
    <Content Include="$(MSBuildProjectDirectory)/../../.tools/julie-extract.exe">
      <Link>.tools/julie-extract.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- MSBuild's Copy does not preserve the unix exec bit, so the copied julie-extract lands non-executable and
       Process.Start would fail with EACCES. Reassert +x on the output copy after build (silent on Windows / when the
       binary was not copied). Keyed off the same Exists condition so it is a no-op on a no-restore machine. -->
  <Target Name="EnsureJulieExtractExecutable" AfterTargets="Build;Publish"
          Condition="!$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(OutDir).tools/julie-extract')">
    <Exec Command="chmod +x &quot;$(OutDir).tools/julie-extract&quot;" />
  </Target>

  <!-- Stale-binary build guard. The Content copy above takes whatever sits in .tools (PreserveNewest) with NO version
       check, so a julie-extract left over from before a pin bump is copied silently; the contract-mismatched runtime
       then loops on schema errors while the "missing binary" recovery never fires (the binary is PRESENT, just one
       schema behind). This target asks the restored binary for its reported version and FAILS the build with a
       restore instruction when it does not match scripts/julie-pins.json. It is OFFLINE (reads the local pin file and
       runs the binary's version flag; no network, integrity vs the GitHub release is already verified at restore
       time):
         missing  => build fails loud HERE;  stale => build fails loud HERE;  current => silent pass.
       A MISSING binary used to build fine and fail at runtime instead. That deferral is what let a no-restore machine
       look healthy until first use, so the missing case is now a build error too; set
       MILLER_ALLOW_MISSING_JULIE_EXTRACT=1 to restore the old fail-at-runtime behaviour for a deliberate offline build.
       Guarded by ServerProjectGuardsAgainstStaleJulieExtractVersion in MillerExtractContractTests. -->
  <Target Name="VerifyPinnedJulieExtractVersion" BeforeTargets="Build;Publish">
    <PropertyGroup>
      <_JulieExtractBinary Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\..\.tools\julie-extract.exe</_JulieExtractBinary>
      <_JulieExtractBinary Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)../../.tools/julie-extract</_JulieExtractBinary>
      <!-- First "version": "<x.y.z>" in the pins file is the top-level download pin (the only one). Nested function so
           the JSON text is passed as a value, never spliced into the expression. -->
      <_JuliePinnedJulieExtractVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../scripts/julie-pins.json')), '"version"\s*:\s*"([^"]*)"').Groups.get_Item(1).Value)</_JuliePinnedJulieExtractVersion>
    </PropertyGroup>

    <Error Condition="'$(_JuliePinnedJulieExtractVersion)' == ''"
           Text="Could not read the pinned julie-extract version from scripts/julie-pins.json; the stale-binary build guard cannot verify .tools/julie-extract." />

    <Error Condition="!Exists('$(_JulieExtractBinary)') And '$(MILLER_ALLOW_MISSING_JULIE_EXTRACT)' != '1'"
           Text="Pinned julie-extract v$(_JuliePinnedJulieExtractVersion) is not restored: '$(_JulieExtractBinary)' does not exist. Miller cannot index without it. Run scripts/restore-julie-extract.ps1 (Windows) or scripts/restore-julie-extract.sh, then rebuild. To build anyway and defer the failure to runtime, set MILLER_ALLOW_MISSING_JULIE_EXTRACT=1." />

    <!-- IgnoreExitCode so a binary that cannot self-report version raises the clear Error below, not a raw MSB3073. -->
    <Exec Condition="Exists('$(_JulieExtractBinary)')"
          Command="&quot;$(_JulieExtractBinary)&quot; --version"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_JulieExtractVersionRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_JulieExtractVersionExit" />
    </Exec>

    <PropertyGroup>
      <_JulieExtractActualVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_JulieExtractVersionRaw)', '[0-9]+\.[0-9]+\.[0-9]+').Value)</_JulieExtractActualVersion>
    </PropertyGroup>

    <Error Condition="Exists('$(_JulieExtractBinary)') And '$(_JulieExtractVersionExit)' != '0'"
           Text="Could not run '$(_JulieExtractBinary) --version' (exit $(_JulieExtractVersionExit)) to verify the pinned julie-extract. Re-run scripts/restore-julie-extract.ps1 (Windows) or scripts/restore-julie-extract.sh." />

    <Error Condition="Exists('$(_JulieExtractBinary)') And '$(_JulieExtractActualVersion)' != '$(_JuliePinnedJulieExtractVersion)'"
           Text="Bundled julie-extract is v$(_JulieExtractActualVersion) but scripts/julie-pins.json pins v$(_JuliePinnedJulieExtractVersion). The build copies .tools/julie-extract as-is (no version check), so a stale binary would silently break the schema contract at runtime. Re-run scripts/restore-julie-extract.ps1 (Windows) or scripts/restore-julie-extract.sh, then rebuild." />
  </Target>

  <!-- The OPTIONAL semantic pair, restored (gitignored) to the repo-root .tools/ by scripts/restore-semantic-sidecar.*:
       the julie-semantic-sidecar embedding binary and the pinned sqlite-vec loadable extension. Same packaged layout as
       julie-extract (<out>/.tools/, located at AppContext.BaseDirectory/.tools), but unlike julie-extract these are not
       required: ADR-0003 makes semantic retrieval optional, so an absent restore must still build AND still run — the
       runtime fails open with a stated reason (VectorStore.ResolveExtensionPath returns null). The Exists conditions are
       therefore the whole optionality contract, not a convenience. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/../../.tools/julie-semantic-sidecar-runtime')">
    <Content Include="$(MSBuildProjectDirectory)/../../.tools/julie-semantic-sidecar-runtime/**/*">
      <Link>.tools/julie-semantic-sidecar-runtime/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- A wildcard, not the three literal names: a literal Include creates the item even when the file is absent and
         the copy then fails, which would turn "semantic not restored" into a build error. -->
    <Content Include="$(MSBuildProjectDirectory)/../../.tools/vec0.*">
      <Link>.tools/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- Same exec-bit reassertion as julie-extract: MSBuild's Copy drops +x and Process.Start would fail EACCES. -->
  <Target Name="EnsureSemanticSidecarExecutable" AfterTargets="Build;Publish"
          Condition="!$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(OutDir).tools/julie-semantic-sidecar-runtime/julie-semantic-sidecar')">
    <Exec Command="chmod +x &quot;$(OutDir).tools/julie-semantic-sidecar-runtime/julie-semantic-sidecar&quot;" />
  </Target>

  <!-- Stale-sidecar build guard, mirroring VerifyPinnedJulieExtractVersion: the Content copy above takes whatever sits
       in .tools with no version check, so a sidecar left over from before a pin bump ships silently and its encoder
       fingerprint no longer matches the vectors.db generation identity. Semantics are
         missing => build fails loud HERE;  stale => build fails loud HERE;  current => silent pass.
       ADR-0003 made a missing sidecar fail OPEN at runtime, which was right while semantic retrieval was opt-in. It is
       now default-on, so failing open silently means the DEFAULT install is quietly degraded — exactly how a machine
       ran for weeks with no vectors and a clean build. Failing the build keeps the fail-open path for people who
       genuinely do not want semantic, but makes them ASK for it: set MILLER_ALLOW_MISSING_SEMANTIC=1 (ci.yml does,
       because it deliberately does not restore the sidecar).
       The version regex admits a prerelease suffix because sidecar pins are release candidates — julie-extract's bare
       [0-9]+\.[0-9]+\.[0-9]+ would truncate that to 0.1.0 and false-pass a later rc. MILLER_SEMANTIC_PINS overrides the
       pin file path, matching the restore scripts, so the guard can be exercised without editing the committed pins. -->
  <Target Name="VerifyPinnedSemanticSidecarVersion" BeforeTargets="Build;Publish"
          Condition="'$(MILLER_ALLOW_MISSING_SEMANTIC)' != '1' Or Exists('$(MSBuildThisFileDirectory)../../.tools/julie-semantic-sidecar-runtime/julie-semantic-sidecar.exe') Or Exists('$(MSBuildThisFileDirectory)../../.tools/julie-semantic-sidecar-runtime/julie-semantic-sidecar')">
    <PropertyGroup>
      <_SemanticSidecarBinary Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\..\.tools\julie-semantic-sidecar-runtime\julie-semantic-sidecar.exe</_SemanticSidecarBinary>
      <_SemanticSidecarBinary Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)../../.tools/julie-semantic-sidecar-runtime/julie-semantic-sidecar</_SemanticSidecarBinary>
      <_SemanticPinsFile Condition="'$(MILLER_SEMANTIC_PINS)' != ''">$(MILLER_SEMANTIC_PINS)</_SemanticPinsFile>
      <_SemanticPinsFile Condition="'$(_SemanticPinsFile)' == ''">$(MSBuildThisFileDirectory)../../scripts/semantic-pins.json</_SemanticPinsFile>
    </PropertyGroup>

    <Error Condition="!Exists('$(_SemanticPinsFile)')"
           Text="Semantic pin file '$(_SemanticPinsFile)' does not exist; the stale-sidecar build guard cannot verify the .tools/julie-semantic-sidecar-runtime package." />

    <PropertyGroup>
      <!-- Anchored on the `sidecar` object so the sqliteVec pin below it can never be read as the sidecar version.
           Nested function so the JSON text is passed as a value, never spliced into the expression. -->
      <_PinnedSemanticSidecarVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(_SemanticPinsFile)')), '"sidecar"\s*:\s*\{[^}]*?"version"\s*:\s*"([^"]*)"').Groups.get_Item(1).Value)</_PinnedSemanticSidecarVersion>
    </PropertyGroup>

    <Error Condition="'$(_PinnedSemanticSidecarVersion)' == ''"
           Text="Could not read the pinned julie-semantic-sidecar version from '$(_SemanticPinsFile)'; the stale-sidecar build guard cannot verify the .tools/julie-semantic-sidecar-runtime package." />

    <Error Condition="!Exists('$(_SemanticSidecarBinary)') And '$(MILLER_ALLOW_MISSING_SEMANTIC)' != '1'"
           Text="Pinned julie-semantic-sidecar v$(_PinnedSemanticSidecarVersion) is not restored: '$(_SemanticSidecarBinary)' does not exist. Semantic retrieval is ON by default, so this build would start, report healthy, and silently serve lexical-only results with no vectors.db. Run scripts/restore-semantic-sidecar.ps1 (Windows) or scripts/restore-semantic-sidecar.sh, then rebuild. To build without semantic on purpose, set MILLER_ALLOW_MISSING_SEMANTIC=1." />

    <!-- IgnoreExitCode so a binary that cannot self-report version raises the clear Error below, not a raw MSB3073. -->
    <Exec Condition="Exists('$(_SemanticSidecarBinary)')"
          Command="&quot;$(_SemanticSidecarBinary)&quot; --version"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_SemanticSidecarVersionRaw" />
      <Output TaskParameter="ExitCode" PropertyName="_SemanticSidecarVersionExit" />
    </Exec>

    <PropertyGroup>
      <_SemanticSidecarActualVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_SemanticSidecarVersionRaw)', '[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.\-]+)?').Value)</_SemanticSidecarActualVersion>
    </PropertyGroup>

    <Error Condition="Exists('$(_SemanticSidecarBinary)') And '$(_SemanticSidecarVersionExit)' != '0'"
           Text="Could not run '$(_SemanticSidecarBinary) --version' (exit $(_SemanticSidecarVersionExit)) to verify the pinned julie-semantic-sidecar. Re-run scripts/restore-semantic-sidecar.ps1 (Windows) or scripts/restore-semantic-sidecar.sh." />

    <Error Condition="Exists('$(_SemanticSidecarBinary)') And '$(_SemanticSidecarActualVersion)' != '$(_PinnedSemanticSidecarVersion)'"
           Text="Bundled julie-semantic-sidecar is v$(_SemanticSidecarActualVersion) but $(_SemanticPinsFile) pins v$(_PinnedSemanticSidecarVersion). The build copies the restored runtime package as-is, so a stale sidecar would emit vectors under an encoder fingerprint the pinned generation identity refuses. Re-run scripts/restore-semantic-sidecar.ps1 (Windows) or scripts/restore-semantic-sidecar.sh, then rebuild." />
  </Target>
</Project>
