@namespace Miller.Dashboard.Components

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="htmx-config" content='{"selfRequestsOnly":true,"allowEval":false}'>
    <title>Miller Dashboard</title>
    <link rel="stylesheet" href="/dashboard.css">
    <script src="/lib/htmx/htmx.min.js"></script>
</head>
<body>
    <main class="shell">
        <header class="dashboard-hero">
            <div class="hero-copy">
                <p class="eyebrow">Local index status</p>
                <h1>Miller Dashboard</h1>
                <p class="hero-subtitle">@HeroSubtitle</p>
            </div>
            <div class="hero-side">
                <nav class="api-actions" aria-label="Dashboard JSON">
                    <a class="api-link" href="/snapshot.json?workspace_id=@Uri.EscapeDataString(Snapshot.SelectedWorkspaceId ?? "")">snapshot.json</a>
                    <a class="api-link" href="/telemetry.json?workspace_id=@Uri.EscapeDataString(Snapshot.SelectedWorkspaceId ?? "")">telemetry.json</a>
                </nav>
                <div class="hero-metrics" aria-label="Dashboard summary">
                    <div>
                        <strong>@Snapshot.Workspaces.Count.ToString("N0", CultureInfo.InvariantCulture)</strong>
                        <span>workspaces</span>
                    </div>
                    <div>
                        <strong>@FormatNullableCount(Snapshot.SelectedWorkspaceFacts?.FileCount)</strong>
                        <span>files</span>
                    </div>
                    <div>
                        <strong>@FormatNullableCount(Snapshot.SelectedWorkspaceFacts?.SymbolCount)</strong>
                        <span>symbols</span>
                    </div>
                </div>
            </div>
        </header>

        <DashboardContent Snapshot="Snapshot" />
    </main>
</body>
</html>

@code {
    [Parameter, EditorRequired] public DashboardSnapshot Snapshot { get; set; } =
        new(Array.Empty<DashboardWorkspaceRow>(), new DashboardTelemetrySummary(null, [], 0, null, null, []), null);

    private string HeroSubtitle => Snapshot.SelectedWorkspaceFacts is null
        ? "Choose a registered workspace to inspect Miller's local index."
        : Snapshot.SelectedWorkspaceFacts.DisplayId;

    private static string FormatNullableCount(long? value) =>
        value?.ToString("N0", CultureInfo.InvariantCulture) ?? "-";
}
