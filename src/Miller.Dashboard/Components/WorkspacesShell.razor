@namespace Miller.Dashboard.Components

<!doctype html>
<html lang="en">
<head>
    <DashboardHead Title="Miller — Workspaces" />
</head>
<body>
    <main class="shell">
        <header class="dashboard-hero">
            <div class="hero-copy">
                <p class="eyebrow">Local index status</p>
                <h1>Miller Workspaces</h1>
                <p class="hero-subtitle">Every code workspace Miller has indexed on this machine. Live roots first; stale (missing root or errored) registrations are collapsed below.</p>
            </div>
            <div class="hero-side">
                <div class="theme-switch-wrapper">
                    <button id="theme-toggle" class="theme-switcher-btn" type="button" data-toggle-theme aria-label="Toggle Theme">
                        <span class="theme-label-dark">Dark</span><span class="theme-label-light">Light</span>
                    </button>
                </div>
                <nav class="api-actions" aria-label="Dashboard JSON">
                    <a class="api-link" href="/workspaces.json" target="_blank" rel="noopener">workspaces.json</a>
                    <a class="api-link" href="/activity.json" target="_blank" rel="noopener">activity.json</a>
                    <a class="api-link" href="/telemetry.json?workspace_id=all" target="_blank" rel="noopener">telemetry.json</a>
                    <a class="api-link" href="/diagnostics.json" target="_blank" rel="noopener">diagnostics.json</a>
                </nav>
                <div class="hero-metrics" aria-label="Machine-wide totals">
                    <div>
                        <strong>@Index.LiveCount.ToString("N0", CultureInfo.InvariantCulture)</strong>
                        <span>live</span>
                    </div>
                    <div>
                        <strong>@Index.WorkspaceCount.ToString("N0", CultureInfo.InvariantCulture)</strong>
                        <span>registered</span>
                    </div>
                    <div>
                        <strong>@Index.TotalFiles.ToString("N0", CultureInfo.InvariantCulture)</strong>
                        <span>files</span>
                    </div>
                    <div>
                        <strong>@Index.TotalSymbols.ToString("N0", CultureInfo.InvariantCulture)</strong>
                        <span>symbols</span>
                    </div>
                </div>
            </div>
        </header>

        <WorkspaceIndex Index="Index" Notice="@Notice" NoticeDetail="@NoticeDetail" />
        <ActivityFeedPanel Feed="EffectiveActivity" />
        @if (Telemetry is not null)
        {
            <details class="panel-collapse telemetry-collapse">
                <summary class="panel-collapse-summary">
                    <span>Machine-wide telemetry</span>
                    <span class="muted">optional rollup — per-workspace telemetry lives on each workspace page</span>
                </summary>
                <TelemetryPanel Telemetry="Telemetry" SelectedWorkspaceId="all" />
            </details>
        }
        <footer class="site-footer">
            <span class="site-footer-version">miller @Miller.Server.MillerVersion.Current</span>
            <a class="site-footer-link" href="/diagnostics.json" target="_blank" rel="noopener">diagnostics.json</a>
        </footer>
    </main>
    <DashboardScripts />
</body>
</html>

@code {
    [Parameter, EditorRequired] public DashboardWorkspaceIndex Index { get; set; } =
        new(Array.Empty<DashboardWorkspaceIndexEntry>(), 0, 0, 0, 0);

    [Parameter] public DashboardActivityFeed? Activity { get; set; }

    /// <summary>Remove/prune outcome code from a post-redirect-get; forwarded to the workspace index notice.</summary>
    [Parameter] public string? Notice { get; set; }

    /// <summary>Detail for the outcome notice (workspace root, pruned count, or error message).</summary>
    [Parameter] public string? NoticeDetail { get; set; }

    [Parameter] public DashboardTelemetrySummary? Telemetry { get; set; }

    private DashboardActivityFeed EffectiveActivity =>
        Activity ?? new DashboardActivityFeed(null, Array.Empty<DashboardActivityEntry>());
}
