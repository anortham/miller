@namespace Miller.Dashboard.Components
@using Microsoft.AspNetCore.Components.Forms

<section id="workspace-index"
         class="panel ws-index-panel"
         x-data="workspaceIndexFilter"
         aria-label="Registered workspaces"
         hx-get="/fragments/workspaces"
         data-poll-trigger="every 30s"
         hx-trigger="every 30s"
         hx-ext="morph"
         hx-swap="morph:outerHTML">
    <div class="panel-heading">
        <div>
            <h2>Workspaces</h2>
            <p>@Index.WorkspaceCount.ToString("N0", CultureInfo.InvariantCulture) registered · @Index.LiveCount.ToString("N0", CultureInfo.InvariantCulture) live · click to inspect</p>
        </div>
        <div class="workspace-index-actions">
            <label class="sr-only" for="workspace-filter">Filter workspaces</label>
            <input id="workspace-filter"
                   class="workspace-filter"
                   type="search"
                   placeholder="Filter workspaces"
                   autocomplete="off"
                   x-bind:value="query"
                   x-on:input="onInput($event)">
            <a href="/workspaces.json" class="subtle-link">json</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Index.Error))
    {
        <p class="notice error-notice"><strong>Registry unavailable</strong> @Index.Error</p>
    }

    @* Remove/prune outcomes arrive as a post-redirect-get query param; the next 30s fragment poll clears them. *@
    @if (NoticeMessage is not null)
    {
        <p class="@(NoticeIsError ? "notice error-notice" : "notice")">@NoticeMessage</p>
    }

    @if (Index.Entries.Count == 0)
    {
        <p class="empty">No registered workspaces yet.</p>
    }
    else
    {
        var live = Index.Entries.Where(static e => !e.IsStale).ToList();
        var stale = Index.Entries.Where(static e => e.IsStale).ToList();
        var staleMissing = stale.Count(static e => !e.RootExists);
        var staleErrored = stale.Count - staleMissing;

        @if (live.Count > 0)
        {
            <div class="ws-index">
                <div class="ws-index-head">
                    <span aria-hidden="true"></span>
                    <button type="button" class="ws-sort" data-sort-col="workspace" aria-sort="none" x-on:click="onSort($event)">Workspace</button>
                    <span>State</span>
                    <button type="button" class="ws-sort ws-num" data-sort-col="files" aria-sort="none" x-on:click="onSort($event)">Files</button>
                    <button type="button" class="ws-sort ws-num" data-sort-col="symbols" aria-sort="none" x-on:click="onSort($event)">Symbols</button>
                    <span>Languages</span>
                    <button type="button" class="ws-sort ws-num" data-sort-col="rev" aria-sort="none" x-on:click="onSort($event)">Rev</button>
                </div>
                @foreach (DashboardWorkspaceIndexEntry entry in live)
                {
                    <div class="ws-index-row" @attributes="SortKeys(entry)">
                        <span class="workspace-status-rail @StateClass(entry.Workspace.State)" aria-hidden="true"></span>
                        <span class="workspace-row-main">
                            <a class="workspace-name" style="text-decoration: none" href="/workspace?workspace_id=@Esc(entry.Workspace.WorkspaceId)">@entry.Workspace.DisplayId</a>
                            <code class="workspace-path" title="@entry.Workspace.CanonicalRoot">@entry.Workspace.CanonicalRoot</code>
                            @if (!string.IsNullOrWhiteSpace(entry.Workspace.LastError))
                            {
                                <span class="workspace-error muted">@entry.Workspace.LastError</span>
                            }
                            <WorkspaceRemoveConfirm WorkspaceId="@entry.Workspace.WorkspaceId" />
                        </span>
                        <span class="ws-cell">
                            <span class="workspace-state @StateClass(entry.Workspace.State)">@entry.Workspace.State</span>
                        </span>
                        <span class="ws-cell ws-num">@Stat(entry, entry.Facts.FileCount)</span>
                        <span class="ws-cell ws-num">@Stat(entry, entry.Facts.SymbolCount)</span>
                        <span class="ws-cell ws-langs">@LanguageSummary(entry)</span>
                        <span class="ws-cell ws-num">@(entry.Workspace.LastRevision?.ToString("N0", CultureInfo.InvariantCulture) ?? "—")</span>
                    </div>
                }
            </div>
        }

        @if (stale.Count > 0)
        {
            <details class="panel-collapse ws-stale-collapse">
                <summary class="panel-collapse-summary">
                    <span>@stale.Count.ToString("N0", CultureInfo.InvariantCulture) stale registrations</span>
                    <span class="muted">
                        @if (staleMissing > 0)
                        {
                            <text>@staleMissing.ToString("N0", CultureInfo.InvariantCulture) missing root — prune below or run <code>miller workspace prune</code></text>
                        }
                        @if (staleMissing > 0 && staleErrored > 0)
                        {
                            <text> · </text>
                        }
                        @if (staleErrored > 0)
                        {
                            <text>@staleErrored.ToString("N0", CultureInfo.InvariantCulture) errored — refresh, or <code>workspace remove</code> if abandoned</text>
                        }
                    </span>
                </summary>
                @if (staleMissing > 0)
                {
                    <form class="detail-actions" method="post" action="/workspaces/prune">
                        <AntiforgeryToken />
                        <button type="submit" class="refresh-button">Prune @staleMissing.ToString("N0", CultureInfo.InvariantCulture) stale</button>
                        <span class="muted">removes every registration whose root folder no longer exists</span>
                    </form>
                }
                <div class="ws-index ws-index-stale">
                    @foreach (DashboardWorkspaceIndexEntry entry in stale)
                    {
                        <div class="ws-index-row" @attributes="SortKeys(entry)">
                            <span class="workspace-status-rail @StateClass(entry.Workspace.State)" aria-hidden="true"></span>
                            <span class="workspace-row-main">
                                <a class="workspace-name" style="text-decoration: none" href="/workspace?workspace_id=@Esc(entry.Workspace.WorkspaceId)">@entry.Workspace.DisplayId</a>
                                <code class="workspace-path" title="@entry.Workspace.CanonicalRoot">@entry.Workspace.CanonicalRoot</code>
                                @if (!entry.RootExists)
                                {
                                    <span class="workspace-error muted">root missing</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(entry.Workspace.LastError))
                                {
                                    <span class="workspace-error muted">@entry.Workspace.LastError</span>
                                }
                                <WorkspaceRemoveConfirm WorkspaceId="@entry.Workspace.WorkspaceId" />
                            </span>
                            <span class="ws-cell">
                                <span class="workspace-state @StateClass(entry.Workspace.State)">@entry.Workspace.State</span>
                            </span>
                            <span class="ws-cell ws-num">@Stat(entry, entry.Facts.FileCount)</span>
                            <span class="ws-cell ws-num">@Stat(entry, entry.Facts.SymbolCount)</span>
                            <span class="ws-cell ws-langs">@LanguageSummary(entry)</span>
                            <span class="ws-cell ws-num">@(entry.Workspace.LastRevision?.ToString("N0", CultureInfo.InvariantCulture) ?? "—")</span>
                        </div>
                    }
                </div>
            </details>
        }

        <p class="empty ws-filter-empty" hidden>No workspaces match the filter.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public DashboardWorkspaceIndex Index { get; set; } =
        new(Array.Empty<DashboardWorkspaceIndexEntry>(), 0, 0, 0, 0);

    /// <summary>Outcome code from a remove/prune post-redirect-get (see DashboardEndpoints); null hides the notice.</summary>
    [Parameter] public string? Notice { get; set; }

    /// <summary>Human detail for the notice: the workspace root/selector, a pruned count, or an error message.</summary>
    [Parameter] public string? NoticeDetail { get; set; }

    // The notice codes are a closed set; an unrecognised code (the query param is craftable) renders nothing.
    private string? NoticeMessage => Notice switch
    {
        "removed" => $"Removed {Subject} — its .miller index data was deleted (reopen anytime with workspace open).",
        "removed-registration" => $"Removed registration {Subject} — no index data was on disk.",
        "remove-refused-in-use" => $"Remove refused — {Subject} is in use by another Miller process.",
        "remove-refused-live" => $"Remove refused — {Subject} is a live workspace.",
        "remove-not-found" => $"No registered workspace matched {Subject}.",
        "remove-error" => $"Remove failed: {NoticeDetail}",
        "pruned" => PrunedMessage,
        _ => null,
    };

    private bool NoticeIsError =>
        Notice is "remove-refused-in-use" or "remove-refused-live" or "remove-not-found" or "remove-error";

    private string Subject => string.IsNullOrWhiteSpace(NoticeDetail) ? "the workspace" : NoticeDetail!;

    private string PrunedMessage =>
        int.TryParse(NoticeDetail, NumberStyles.Integer, CultureInfo.InvariantCulture, out int n) && n > 0
            ? $"Pruned {n.ToString("N0", CultureInfo.InvariantCulture)} stale registration{(n == 1 ? "" : "s")}."
            : "No stale registrations to prune.";

    // Clean numeric/name sort keys so the client sorts on values, not formatted "1,234"/"—" strings.
    // Fact-less rows use -1 so they sort below rows that have real counts.
    private static Dictionary<string, object> SortKeys(DashboardWorkspaceIndexEntry entry) => new()
    {
        ["data-sort-files"] = entry.HasFacts ? entry.Facts.FileCount : -1,
        ["data-sort-symbols"] = entry.HasFacts ? entry.Facts.SymbolCount : -1,
        ["data-sort-rev"] = entry.Workspace.LastRevision ?? -1,
        ["data-sort-name"] = entry.Workspace.DisplayId,
    };

    private static string Stat(DashboardWorkspaceIndexEntry entry, long value) =>
        entry.HasFacts ? value.ToString("N0", CultureInfo.InvariantCulture) : "—";

    private static string LanguageSummary(DashboardWorkspaceIndexEntry entry)
    {
        if (!entry.HasFacts || entry.Facts.Languages.Count == 0)
            return "—";

        var names = entry.Facts.Languages.Take(3).Select(l => l.Language).ToList();
        int extra = entry.Facts.Languages.Count - names.Count;
        string head = string.Join(" · ", names);
        return extra > 0 ? $"{head} +{extra}" : head;
    }
}
