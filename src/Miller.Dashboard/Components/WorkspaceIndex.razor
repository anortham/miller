@namespace Miller.Dashboard.Components

<section id="workspace-index" class="panel ws-index-panel" x-data="workspaceIndexFilter" aria-label="Registered workspaces">
    <div class="panel-heading">
        <div>
            <h2>Workspaces</h2>
            <p>@Index.WorkspaceCount.ToString("N0", CultureInfo.InvariantCulture) registered · @Index.LiveCount.ToString("N0", CultureInfo.InvariantCulture) live · click to inspect</p>
        </div>
        <div class="workspace-index-actions">
            <label class="sr-only" for="workspace-filter">Filter workspaces</label>
            <input id="workspace-filter"
                   class="workspace-filter"
                   type="search"
                   placeholder="Filter workspaces"
                   autocomplete="off"
                   x-bind:value="query"
                   x-on:input="onInput($event)">
            <a href="/workspaces.json" class="subtle-link">json</a>
        </div>
    </div>

    @if (Index.Entries.Count == 0)
    {
        <p class="empty">No registered workspaces yet.</p>
    }
    else
    {
        var live = Index.Entries.Where(static e => !e.IsStale).ToList();
        var stale = Index.Entries.Where(static e => e.IsStale).ToList();
        var staleMissing = stale.Count(static e => !e.RootExists);
        var staleErrored = stale.Count - staleMissing;

        @if (live.Count > 0)
        {
            <div class="ws-index" role="table">
                <div class="ws-index-head" role="row" aria-hidden="true">
                    <span></span>
                    <span>Workspace</span>
                    <span>State</span>
                    <span class="ws-num">Files</span>
                    <span class="ws-num">Symbols</span>
                    <span>Languages</span>
                    <span class="ws-num">Rev</span>
                </div>
                @foreach (DashboardWorkspaceIndexEntry entry in live)
                {
                    <a class="ws-index-row" role="row" href="/workspace?workspace_id=@Esc(entry.Workspace.WorkspaceId)">
                        <span class="workspace-status-rail @StateClass(entry.Workspace.State)" aria-hidden="true"></span>
                        <span class="workspace-row-main">
                            <span class="workspace-name">@entry.Workspace.DisplayId</span>
                            <code class="workspace-path" title="@entry.Workspace.CanonicalRoot">@entry.Workspace.CanonicalRoot</code>
                            @if (!string.IsNullOrWhiteSpace(entry.Workspace.LastError))
                            {
                                <span class="workspace-error muted">@entry.Workspace.LastError</span>
                            }
                        </span>
                        <span class="ws-cell">
                            <span class="workspace-state @StateClass(entry.Workspace.State)">@entry.Workspace.State</span>
                        </span>
                        <span class="ws-cell ws-num">@Stat(entry, entry.Facts.FileCount)</span>
                        <span class="ws-cell ws-num">@Stat(entry, entry.Facts.SymbolCount)</span>
                        <span class="ws-cell ws-langs">@LanguageSummary(entry)</span>
                        <span class="ws-cell ws-num">@(entry.Workspace.LastRevision?.ToString("N0", CultureInfo.InvariantCulture) ?? "—")</span>
                    </a>
                }
            </div>
        }

        @if (stale.Count > 0)
        {
            <details class="panel-collapse ws-stale-collapse">
                <summary class="panel-collapse-summary">
                    <span>@stale.Count.ToString("N0", CultureInfo.InvariantCulture) stale registrations</span>
                    <span class="muted">
                        @if (staleMissing > 0)
                        {
                            <text>@staleMissing.ToString("N0", CultureInfo.InvariantCulture) missing root — run <code>miller workspace prune</code> to remove</text>
                        }
                        @if (staleMissing > 0 && staleErrored > 0)
                        {
                            <text> · </text>
                        }
                        @if (staleErrored > 0)
                        {
                            <text>@staleErrored.ToString("N0", CultureInfo.InvariantCulture) errored — refresh, or <code>workspace remove</code> if abandoned</text>
                        }
                    </span>
                </summary>
                <div class="ws-index ws-index-stale" role="table">
                    @foreach (DashboardWorkspaceIndexEntry entry in stale)
                    {
                        <a class="ws-index-row" role="row" href="/workspace?workspace_id=@Esc(entry.Workspace.WorkspaceId)">
                            <span class="workspace-status-rail @StateClass(entry.Workspace.State)" aria-hidden="true"></span>
                            <span class="workspace-row-main">
                                <span class="workspace-name">@entry.Workspace.DisplayId</span>
                                <code class="workspace-path" title="@entry.Workspace.CanonicalRoot">@entry.Workspace.CanonicalRoot</code>
                                @if (!entry.RootExists)
                                {
                                    <span class="workspace-error muted">root missing</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(entry.Workspace.LastError))
                                {
                                    <span class="workspace-error muted">@entry.Workspace.LastError</span>
                                }
                            </span>
                            <span class="ws-cell">
                                <span class="workspace-state @StateClass(entry.Workspace.State)">@entry.Workspace.State</span>
                            </span>
                            <span class="ws-cell ws-num">@Stat(entry, entry.Facts.FileCount)</span>
                            <span class="ws-cell ws-num">@Stat(entry, entry.Facts.SymbolCount)</span>
                            <span class="ws-cell ws-langs">@LanguageSummary(entry)</span>
                            <span class="ws-cell ws-num">@(entry.Workspace.LastRevision?.ToString("N0", CultureInfo.InvariantCulture) ?? "—")</span>
                        </a>
                    }
                </div>
            </details>
        }

        <p class="empty ws-filter-empty" hidden>No workspaces match the filter.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public DashboardWorkspaceIndex Index { get; set; } =
        new(Array.Empty<DashboardWorkspaceIndexEntry>(), 0, 0, 0, 0);

    private static string Stat(DashboardWorkspaceIndexEntry entry, long value) =>
        entry.HasFacts ? value.ToString("N0", CultureInfo.InvariantCulture) : "—";

    private static string LanguageSummary(DashboardWorkspaceIndexEntry entry)
    {
        if (!entry.HasFacts || entry.Facts.Languages.Count == 0)
            return "—";

        var names = entry.Facts.Languages.Take(3).Select(l => l.Language).ToList();
        int extra = entry.Facts.Languages.Count - names.Count;
        string head = string.Join(" · ", names);
        return extra > 0 ? $"{head} +{extra}" : head;
    }
}
