@namespace Miller.Dashboard.Components

<section id="workspaces-panel"
         class="panel workspaces"
         hx-get="/fragments/workspaces?workspace_id=@Esc(SelectedWorkspaceId)"
         hx-trigger="refresh-workspaces from:body"
         hx-swap="outerHTML">
    <div class="panel-heading">
        <div>
            <h2>Workspaces</h2>
            <p>@Workspaces.Count.ToString("N0", CultureInfo.InvariantCulture) registered</p>
        </div>
        <a href="/workspaces.json" class="subtle-link">json</a>
    </div>

    @if (Workspaces.Count == 0)
    {
        <p class="empty">No registered workspaces yet.</p>
    }
    else
    {
        <div class="workspace-list">
            @foreach (DashboardWorkspaceRow row in Workspaces)
            {
                bool selected = string.Equals(row.WorkspaceId, SelectedWorkspaceId, StringComparison.Ordinal);
                <button type="button"
                        class="workspace-row @(selected ? "selected" : "")"
                        hx-get="/fragments/dashboard?workspace_id=@Esc(row.WorkspaceId)"
                        hx-target="#dashboard-content"
                        hx-swap="outerHTML"
                        aria-current="@(selected ? "true" : "false")">
                    <span class="workspace-name">@row.DisplayId</span>
                    <span class="workspace-state @StateClass(row.State)">@row.State</span>
                    <span class="workspace-meta">rev @(row.LastRevision?.ToString(CultureInfo.InvariantCulture) ?? "-")</span>
                    <code>@row.CanonicalRoot</code>
                </button>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DashboardWorkspaceRow> Workspaces { get; set; } =
        Array.Empty<DashboardWorkspaceRow>();

    [Parameter] public string? SelectedWorkspaceId { get; set; }

    private static string Esc(string? value) => Uri.EscapeDataString(value ?? string.Empty);

    private static string StateClass(string state) => state switch
    {
        "ready" or "current" or "loaded_existing" => "ok",
        "missing" or "error" => "bad",
        _ => "neutral",
    };
}
