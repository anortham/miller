@namespace Miller.Dashboard.Components

<section id="workspace-detail-panel" class="panel detail-panel" aria-label="Selected workspace index facts">
    <div class="panel-heading">
        <div>
            <h2>Index transparency</h2>
            <p>@Subtitle</p>
        </div>
        @if (Facts is not null)
        {
            <div class="detail-actions">
                <RefreshStatusPanel Job="RefreshJob" WorkspaceId="@Facts.WorkspaceId" />
                <button class="refresh-button"
                        type="button"
                        hx-post="/fragments/refresh?workspace_id=@Esc(Facts.WorkspaceId)"
                        hx-target="#workspace-detail-stack"
                        hx-ext="morph"
                        hx-swap="morph:outerHTML"
                        hx-disabled-elt="this">
                    <span class="refresh-button-label">Refresh index</span>
                    <span class="refresh-button-indicator" aria-hidden="true">Refreshing…</span>
                </button>
                <button class="refresh-button open-folder-button"
                        type="button"
                        hx-post="/workspaces/@Esc(Facts.WorkspaceId)/open-folder"
                        hx-swap="none"
                        data-toast-success="Opening the workspace folder…">Open folder</button>
                <span class="workspace-state @StateClass(Facts.Status)">@Facts.Status</span>
                <WorkspaceRemoveConfirm WorkspaceId="@Facts.WorkspaceId" />
            </div>
        }
    </div>

    @if (Facts is null)
    {
        <p class="empty">Select a workspace to inspect the local index.</p>
    }
    else
    {
        <div class="copy-row" aria-label="Workspace selectors">
            <span id="copy-display-id" class="copy-source">@Facts.DisplayId</span>
            <button class="copy-issue-button" type="button" data-copy-target="copy-display-id" aria-label="Copy display id">Copy id</button>
            <span id="copy-workspace-id" class="copy-source hidden-copy">@Facts.WorkspaceId</span>
            <button class="copy-issue-button" type="button" data-copy-target="copy-workspace-id" aria-label="Copy workspace id">Copy workspace_id</button>
            <span id="copy-root-path" class="copy-source hidden-copy">@Facts.CanonicalRoot</span>
            <button class="copy-issue-button" type="button" data-copy-target="copy-root-path" aria-label="Copy root path">Copy path</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Facts.RegistryLastError))
        {
            <p class="notice error-notice"><strong>Registry error</strong> @Facts.RegistryLastError</p>
        }

        <div class="stats-grid metric-band">
            <div class="metric">
                <strong>@FormatCount(Facts.FileCount, "file")</strong>
                <span>tracked in files</span>
            </div>
            <div class="metric">
                <strong>@FormatCount(Facts.SymbolCount, "symbol")</strong>
                <span>searchable symbols</span>
            </div>
            <div class="metric">
                <strong>@FormatCount(Facts.LanguageCount, "language")</strong>
                <span>language groups</span>
            </div>
            <div class="metric">
                <strong>@FormatBytes(Facts.ContentBytes)</strong>
                <span>indexed bytes</span>
            </div>
        </div>

        <dl class="fact-list fact-list-wide">
            <div>
                <dt>Freshness</dt>
                <dd>
                    <span class="workspace-state @FreshnessStateClass(Facts.FreshnessStatus)">@Facts.FreshnessStatus</span>
                    <span class="muted freshness-hint">@FreshnessLabel(Facts.FreshnessStatus)</span>
                </dd>
            </div>
            <div>
                <dt title="A counter Miller bumps every time it re-extracts this workspace; a higher number means a newer index.">Revision</dt>
                <dd>
                    @(Facts.IndexRevision?.ToString("N0", CultureInfo.InvariantCulture) ?? Facts.LastRevision?.ToString("N0", CultureInfo.InvariantCulture) ?? "n/a")
                    @if (Facts.LastRevision is not null && Facts.IndexRevision is not null && Facts.LastRevision != Facts.IndexRevision)
                    {
                        <span class="muted">registry @Facts.LastRevision.Value.ToString("N0", CultureInfo.InvariantCulture)</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Last scan</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(Facts.LastScanAt))
                    {
                        <span class="muted">n/a</span>
                    }
                    else
                    {
                        <time class="rel-ts timestamp" datetime="@Facts.LastScanAt" data-ts="@Facts.LastScanAt">@RelativeTime(Facts.LastScanAt, Now)</time>
                    }
                </dd>
            </div>
            <div>
                <dt>Extractor</dt>
                <dd>@(Facts.ExtractorVersion ?? "n/a")</dd>
            </div>
            <div>
                <dt title="The extractor output database Miller reads. Its id changes on every full rebuild of the index.">Artifact</dt>
                <dd>
                    @if (string.IsNullOrWhiteSpace(Facts.ArtifactId))
                    {
                        <span class="muted">n/a</span>
                    }
                    else
                    {
                        <span class="id-chip" title="@Facts.ArtifactId">@ChipText(Facts.ArtifactId)</span>
                        <span id="copy-artifact-id" class="copy-source hidden-copy">@Facts.ArtifactId</span>
                        <button class="copy-issue-button" type="button" data-copy-target="copy-artifact-id" aria-label="Copy artifact id">Copy</button>
                    }
                </dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Facts.ReboundFromRoot))
            {
                <div>
                    <dt title="This index was seeded from another checkout's artifact and retargeted, instead of being extracted from scratch.">Rebound from</dt>
                    <dd>
                        <span title="@Facts.ReboundFromRoot">@(Facts.ReboundFromWorkspace ?? Facts.ReboundFromRoot)</span>
                        @if (!string.IsNullOrWhiteSpace(Facts.ReboundAt))
                        {
                            <time class="rel-ts timestamp" datetime="@Facts.ReboundAt" data-ts="@Facts.ReboundAt">@RelativeTime(Facts.ReboundAt, Now)</time>
                        }
                        @if (!string.IsNullOrWhiteSpace(Facts.ReboundFromArtifactId))
                        {
                            <span class="id-chip" title="@Facts.ReboundFromArtifactId">@ChipText(Facts.ReboundFromArtifactId)</span>
                        }
                    </dd>
                </div>
            }
            <div>
                <dt title="A derived search index Miller builds next to the main database so symbol lookups stay fast.">Search sidecar</dt>
                <dd>
                    search.db @Facts.SearchSidecarStatus
                    @if (!string.IsNullOrWhiteSpace(SidecarRemediationHint(Facts.SearchSidecarStatus)))
                    {
                        <span class="muted sidecar-hint">@SidecarRemediationHint(Facts.SearchSidecarStatus)</span>
                    }
                </dd>
            </div>
            <div>
                <dt title="A derived text index for searching file and doc contents, built alongside the main database.">Content sidecar</dt>
                <dd>
                    content.db @Facts.ContentSidecarStatus
                    @if (!string.IsNullOrWhiteSpace(SidecarRemediationHint(Facts.ContentSidecarStatus)))
                    {
                        <span class="muted sidecar-hint">@SidecarRemediationHint(Facts.ContentSidecarStatus)</span>
                    }
                </dd>
            </div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Facts.Message))
        {
            <p class="notice">@Facts.Message</p>
        }

        @if (Facts.Languages.Count > 0)
        {
            <div class="language-strip" aria-label="Top languages">
                @foreach (DashboardLanguageStat language in Facts.Languages.Take(6))
                {
                    <span class="language-pill">
                        <span>@language.Language</span>
                        <strong>@FormatCount(language.FileCount, "file")</strong>
                    </span>
                }
            </div>
        }

        <div class="breakdown-grid detail-grid">
            <section class="breakdown" aria-label="Language breakdown">
                <h3>Languages</h3>
                @if (Facts.Languages.Count == 0)
                {
                    <p class="empty-inline">No language rows.</p>
                }
                else
                {
                    <ol>
                        @foreach (DashboardLanguageStat language in Facts.Languages)
                        {
                            <li>
                                <div class="breakdown-row">
                                    <span>@language.Language</span>
                                    <span>@FormatCount(language.FileCount, "file")</span>
                                </div>
                                <div class="meter" aria-hidden="true">
                                    <span style="width:@LanguageWidth(language.FileCount)"></span>
                                </div>
                                <small>@FormatCount(language.SymbolCount, "symbol") · @FormatBytes(language.ContentBytes)</small>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="breakdown" aria-label="Symbol kind breakdown">
                <h3>Symbol kinds</h3>
                @if (Facts.SymbolKinds.Count == 0)
                {
                    <p class="empty-inline">No symbol rows.</p>
                }
                else
                {
                    <ol>
                        @foreach (DashboardSymbolKindStat kind in Facts.SymbolKinds)
                        {
                            <li>
                                <div class="breakdown-row">
                                    <span>@kind.Kind</span>
                                    <span>@FormatCount(kind.Count, "symbol")</span>
                                </div>
                                <div class="meter secondary" aria-hidden="true">
                                    <span style="width:@KindWidth(kind.Count)"></span>
                                </div>
                            </li>
                        }
                    </ol>
                    @if (Facts.SymbolKindCount > Facts.SymbolKinds.Count)
                    {
                        <p class="truncation-note muted">+@(Facts.SymbolKindCount - Facts.SymbolKinds.Count) more kinds not shown</p>
                    }
                }
            </section>
        </div>
    }
</section>

@code {
    [Parameter] public DashboardWorkspaceFacts? Facts { get; set; }

    [Parameter] public DashboardRefreshJobStatus? RefreshJob { get; set; }

    // One "now" per render so the last-scan <time> humanizes against the same instant the client repaints from.
    private readonly DateTimeOffset Now = DateTimeOffset.UtcNow;

    private const int ChipHeadLength = 12;

    // Truncate a long identifier to a copyable chip label (first N chars + ellipsis); full value rides in title/copy source.
    private static string ChipText(string? value) =>
        string.IsNullOrEmpty(value) ? string.Empty
        : value.Length <= ChipHeadLength ? value
        : value[..ChipHeadLength] + "…";

    private string Subtitle => Facts is null
        ? "No workspace selected"
        : Facts.DisplayId;

    private long MaxLanguageFiles => Math.Max(1, Facts?.Languages.Count > 0 ? Facts.Languages.Max(l => l.FileCount) : 1);

    private long MaxSymbolKindCount =>
        Math.Max(1, Facts?.SymbolKinds.Count > 0 ? Facts.SymbolKinds.Max(k => k.Count) : 1);

    private string LanguageWidth(long count) =>
        (Math.Max(8, count * 100 / MaxLanguageFiles)).ToString(CultureInfo.InvariantCulture) + "%";

    private string KindWidth(long count) =>
        (Math.Max(8, count * 100 / MaxSymbolKindCount)).ToString(CultureInfo.InvariantCulture) + "%";
}
