@namespace Miller.Dashboard.Components
@using Miller.Server.Workspaces

@* Swap target for the workspace refresh button. Rendered empty on the page; the POST /fragments/refresh
   response replaces it with a running state that polls itself to the refresh outcome. The poll attributes
   exist ONLY while the job runs, and hx-target MUST stay "this": htmx re-inits the swapped-in node and
   clears the poll timer there, so an ancestor target would leave the 2-second timer running forever. *@
<span id="refresh-status" class="refresh-status @CssClass" @attributes="PollAttributes">@Label</span>

@code {
    [Parameter] public DashboardRefreshJobStatus? Job { get; set; }

    [Parameter] public string? WorkspaceId { get; set; }

    private bool IsRunning => Job is { State: DashboardRefreshJobState.Running };

    private WorkspaceRefreshResult? Result => Job?.Result;

    private Dictionary<string, object>? PollAttributes => IsRunning
        ? new Dictionary<string, object>
        {
            ["hx-get"] = $"/fragments/refresh-status?workspace_id={Esc(WorkspaceId)}",
            ["data-poll-trigger"] = "every 2s",
            ["hx-trigger"] = "every 2s",
            ["hx-target"] = "this",
            ["hx-ext"] = "morph",
            ["hx-swap"] = "morph:outerHTML",
        }
        : null;

    private string CssClass
    {
        get
        {
            // Reuses the muted "neutral" tone: a job in flight is not an outcome yet.
            if (IsRunning)
                return "neutral";
            return Result switch
            {
                null => string.Empty,
                { Status: WorkspaceRefreshStatus.Refreshed or WorkspaceRefreshStatus.Unchanged } => "ok",
                // The live server leader holds the lock and converges on its own — not a failure.
                { Status: WorkspaceRefreshStatus.LockBusy } => "neutral",
                _ => "bad",
            };
        }
    }

    private string Label
    {
        get
        {
            if (IsRunning)
                return $"Refreshing… started {ElapsedSeconds}s ago";
            if (Result is null)
                return string.Empty;
            string label = Result.StatusText;
            if (Result.Revision is { } revision)
                label += $" · rev {revision.ToString("N0", CultureInfo.InvariantCulture)}";
            if (!string.IsNullOrWhiteSpace(Result.Error))
                label += $" · {Result.Error}";
            return label;
        }
    }

    private string ElapsedSeconds =>
        Math.Max(0, (long)(Job?.Elapsed.TotalSeconds ?? 0)).ToString(CultureInfo.InvariantCulture);
}
