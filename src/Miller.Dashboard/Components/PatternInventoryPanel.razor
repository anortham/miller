@namespace Miller.Dashboard.Components

<section id="pattern-inventory-panel" class="panel pattern-inventory-panel" aria-label="Pattern inventory">
    <div class="panel-heading">
        <div>
            <h2>Pattern inventory</h2>
            <p>Observed structural-fact families from workspace health aggregates.</p>
        </div>
        @if (Inventory is not null)
        {
            <span class="workspace-state @HealthStateClass(Inventory.State)">@Inventory.State</span>
        }
    </div>

    @if (Inventory is null)
    {
        <p class="empty">Select a workspace to view pattern inventory.</p>
    }
    else if (!string.IsNullOrWhiteSpace(Inventory.Error))
    {
        <p class="notice error-notice"><strong>Pattern inventory unavailable</strong> @Inventory.Error</p>
    }
    else if (Inventory.Families.Count == 0)
    {
        <p class="empty-inline">No structural facts observed.</p>
    }
    else
    {
        <ol class="pattern-family-list">
            @foreach (DashboardPatternFamily family in Inventory.Families)
            {
                <li id="pattern-family-@family.Family">
                    <div class="breakdown-row">
                        <code>@family.Family</code>
                        <span>@family.FactCount facts</span>
                    </div>
                    <small>@FamilyDetails(family)</small>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter] public DashboardPatternInventoryPanel? Inventory { get; set; }

    private static string FamilyDetails(DashboardPatternFamily family)
    {
        var parts = new List<string> { "languages: " + string.Join(", ", family.Languages) };
        if (family.PatternCount > 1)
            parts.Add(FormatCount(family.PatternCount, "pattern"));
        if (HasInformativeCaptures(family))
            parts.Add("captures: " + string.Join(", ", family.Captures));
        return string.Join(" · ", parts);
    }

    /// <summary>A lone capture that just repeats the family's trailing segment (json.property → "property")
    /// restates the family name, so it is dropped rather than rendered.</summary>
    private static bool HasInformativeCaptures(DashboardPatternFamily family)
    {
        if (family.Captures.Count == 0)
            return false;
        if (family.Captures.Count > 1)
            return true;

        string tail = family.Family[(family.Family.LastIndexOf('.') + 1)..];
        return !string.Equals(family.Captures[0], tail, StringComparison.OrdinalIgnoreCase);
    }

    private static string HealthStateClass(string state) => state switch
    {
        "ready" => "ok",
        "empty" => "neutral",
        _ => "bad",
    };
}
