@namespace Miller.Dashboard.Components

<section id="telemetry-panel"
         class="panel telemetry"
         hx-get="/fragments/telemetry?workspace_id=@Esc(SelectedWorkspaceId)"
         data-poll-trigger="every 30s"
         hx-trigger="every 30s"
         hx-swap="outerHTML">
    <div class="panel-heading">
        <div>
            <h2>Telemetry</h2>
            <p>@Telemetry.TotalCalls.ToString("N0", CultureInfo.InvariantCulture) calls @WindowLabel</p>
        </div>
        <button class="refresh-button"
                type="button"
                hx-get="/fragments/telemetry?workspace_id=@Esc(SelectedWorkspaceId)"
                hx-target="#telemetry-panel"
                hx-swap="outerHTML">Refresh</button>
    </div>

    @if (string.IsNullOrWhiteSpace(SelectedWorkspaceId))
    {
        <p class="empty">Select a workspace to view captured telemetry.</p>
    }
    else if (Telemetry.Tools.Count == 0)
    {
        <p class="empty">@(AllWorkspaces ? "No telemetry recorded yet." : "No telemetry recorded for this workspace yet.")</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Tool</th>
                        <th>Calls</th>
                        <th class="telemetry-col-optional">Avg ms</th>
                        <th class="telemetry-col-optional">p95 ms</th>
                        <th class="telemetry-col-optional">Max ms</th>
                        <th>Errors</th>
                        <th>Last call</th>
                        <th class="telemetry-col-optional">Last error</th>
                        <th class="telemetry-col-optional">Est tokens</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DashboardToolStat tool in Telemetry.Tools)
                    {
                        <tr class="@(tool.ErrorCount > 0 ? "has-errors" : "")">
                            <td><code>@tool.Tool</code></td>
                            <td>@tool.Calls.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="telemetry-col-optional">@tool.AvgMs.ToString("0.0", CultureInfo.InvariantCulture)</td>
                            <td class="telemetry-col-optional"><span aria-label="p95 latency">@tool.P95Ms.ToString("N0", CultureInfo.InvariantCulture)</span></td>
                            <td class="telemetry-col-optional">@tool.MaxMs.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td>@tool.ErrorCount.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td>
                                <span class="outcome @OutcomeClass(tool.LastOutcome)">@DisplayOutcome(tool.LastOutcome)</span>
                                @if (tool.LastCallTs is null)
                                {
                                    <span class="timestamp">n/a</span>
                                }
                                else
                                {
                                    <time class="rel-ts timestamp" datetime="@tool.LastCallTs" data-ts="@tool.LastCallTs">@RelativeTime(tool.LastCallTs, Now)</time>
                                }
                            </td>
                            <td class="telemetry-col-optional">
                                @if (tool.LastErrorTs is null)
                                {
                                    <span class="muted">none</span>
                                }
                                else
                                {
                                    <span class="error-kind">@tool.LastErrorKind</span>
                                    <time class="rel-ts timestamp" datetime="@tool.LastErrorTs" data-ts="@tool.LastErrorTs">@RelativeTime(tool.LastErrorTs, Now)</time>
                                }
                            </td>
                            <td class="telemetry-col-optional">@tool.SumEstTokens.ToString("N0", CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Telemetry.RecentErrors.Count > 0)
        {
            <div class="recent-errors">
                <h3>Recent errors</h3>
                <ol>
                    @foreach (DashboardRecentError error in Telemetry.RecentErrors)
                    {
                        <li>
                            <time class="rel-ts timestamp" datetime="@error.Ts" data-ts="@error.Ts">@RelativeTime(error.Ts, Now)</time>
                            <code>@error.Tool</code>
                            @if (!string.IsNullOrWhiteSpace(error.Op))
                            {
                                <span class="muted">@error.Op</span>
                            }
                            <span class="error-kind">@error.ErrorKind</span>
                            <span class="muted">@error.DurationMs.ToString("N0", CultureInfo.InvariantCulture) ms</span>
                            @if (HasIssueDetails(error))
                            {
                                string issueId = IssueId(error);
                                string copyId = IssueCopyId(error);
                                <details class="error-detail recent-error-detail"
                                         data-issue-details
                                         data-issue-id="@issueId">
                                    <summary>view issue details</summary>
                                    <div class="issue-actions">
                                        <button class="copy-issue-button"
                                                type="button"
                                                data-copy-target="@copyId"
                                                aria-label="Copy issue details">Copy</button>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(error.Id))
                                    {
                                        <p><strong>cid</strong> <code>@error.Id</code></p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                                    {
                                        <p>@error.ErrorMessage</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(error.ErrorDetail))
                                    {
                                        <pre>@error.ErrorDetail</pre>
                                    }
                                    <textarea id="@copyId" class="copy-box" readonly rows="7">@IssueBundle(error)</textarea>
                                </details>
                            }
                        </li>
                    }
                </ol>
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public DashboardTelemetrySummary Telemetry { get; set; } =
        new(null, [], 0, null, null, []);

    [Parameter] public string? SelectedWorkspaceId { get; set; }

    // One "now" per render so every row humanizes against the same instant.
    private readonly DateTimeOffset Now = DateTimeOffset.UtcNow;

    private bool AllWorkspaces => string.Equals(SelectedWorkspaceId, "all", StringComparison.Ordinal);

    // Short absolute UTC bounds — a relative "from … to …" reads oddly for a fixed window.
    private string WindowLabel =>
        Telemetry.WindowStartTs is null || Telemetry.WindowEndTs is null
            ? string.Empty
            : $"from {AbsoluteShort(Telemetry.WindowStartTs)} to {AbsoluteShort(Telemetry.WindowEndTs)}";

    private static string DisplayOutcome(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "unknown" : value;

    private static bool HasIssueDetails(DashboardRecentError error) =>
        !string.IsNullOrWhiteSpace(error.Id) ||
        !string.IsNullOrWhiteSpace(error.WorkspaceId) ||
        !string.IsNullOrWhiteSpace(error.ErrorMessage) ||
        !string.IsNullOrWhiteSpace(error.ErrorDetail);

    private static string IssueId(DashboardRecentError error) =>
        !string.IsNullOrWhiteSpace(error.Id)
            ? error.Id
            : $"{error.Tool}-{error.Ts}";

    private static string IssueCopyId(DashboardRecentError error) =>
        $"issue-copy-{IssueId(error)}";

    private static string IssueBundle(DashboardRecentError error)
    {
        var lines = new List<string>
        {
            "Miller dashboard issue details",
            $"cid: {error.Id ?? "n/a"}",
            $"timestamp: {error.Ts}",
            $"workspace_id: {error.WorkspaceId ?? "n/a"}",
            $"tool: {error.Tool}",
            $"operation: {error.Op ?? "n/a"}",
            $"outcome: error",
            $"error_kind: {error.ErrorKind ?? "n/a"}",
            $"duration_ms: {error.DurationMs.ToString(CultureInfo.InvariantCulture)}",
        };
        if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
            lines.Add($"message: {error.ErrorMessage}");
        if (!string.IsNullOrWhiteSpace(error.ErrorDetail))
        {
            lines.Add("detail:");
            lines.Add(error.ErrorDetail);
        }

        return string.Join(Environment.NewLine, lines);
    }
}
