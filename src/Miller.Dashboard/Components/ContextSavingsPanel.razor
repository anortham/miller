@namespace Miller.Dashboard.Components

<section id="context-savings-panel" class="panel savings-panel" aria-label="Context savings">
    <div class="panel-heading">
        <div>
            <h2>Context saved</h2>
            <p>@Subtitle</p>
        </div>
    </div>

    @if (Summary.Status != "tracked")
    {
        <p class="empty">Context savings are not yet tracked for this workspace.</p>
    }
    else
    {
        <div class="savings-summary">
            <div class="metric hero-metric">
                <strong>@FormatBytes(Summary.SavedBytes)</strong>
                <span>saved from tool responses</span>
            </div>
            <div class="metric">
                <strong>@FormatBytes(Summary.SourceBytes)</strong>
                <span>source bytes examined</span>
            </div>
            <div class="metric">
                <strong>@FormatBytes(Summary.BytesReturned)</strong>
                <span>returned to the agent</span>
            </div>
            <div class="metric">
                <strong>@FormatCount(Summary.EstimatedReturnedTokens, "token")</strong>
                <span>estimated returned tokens</span>
            </div>
        </div>

        @if (Summary.Tools.Count > 0)
        {
            <div class="tool-savings">
                <h3>Top tools</h3>
                <ol>
                    @foreach (DashboardContextSavingsTool tool in Summary.Tools)
                    {
                        <li>
                            <div class="breakdown-row">
                                <code>@tool.Tool</code>
                                <span>@FormatBytes(tool.SavedBytes)</span>
                            </div>
                            <div class="meter savings" aria-hidden="true">
                                <span style="width:@ToolWidth(tool.SavedBytes)"></span>
                            </div>
                            <small>
                                @FormatCount(tool.TrackedCalls, "call") ·
                                @FormatBytes(tool.SourceBytes) source ·
                                @FormatBytes(tool.BytesReturned) returned
                            </small>
                        </li>
                    }
                </ol>
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public DashboardContextSavingsSummary Summary { get; set; } =
        DashboardContextSavingsSummary.NotTracked(null);

    private string Subtitle => Summary.Status == "tracked"
        ? FormatCount(Summary.TrackedCalls, "tracked call")
        : "source bytes not yet recorded";

    private long MaxSavedBytes => Math.Max(1, Summary.Tools.Count > 0 ? Summary.Tools.Max(t => t.SavedBytes) : 1);

    private string ToolWidth(long savedBytes) =>
        (Math.Max(8, savedBytes * 100 / MaxSavedBytes)).ToString(CultureInfo.InvariantCulture) + "%";
}
