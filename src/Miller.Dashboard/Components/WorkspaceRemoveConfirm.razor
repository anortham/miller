@namespace Miller.Dashboard.Components
@using Microsoft.AspNetCore.Components.Forms

@* Shared remove control (all-workspaces rows + workspace detail page) so the confirm copy,
   antiforgery token, and endpoint cannot drift between views. The details/summary expand is CSS-only;
   Cancel closes it through the delegated data-close-details handler rather than navigating, which would
   cost the reader their scroll and filter state. With JS off it degrades to re-clicking the summary. *@
<details data-issue-details data-issue-id="remove-@WorkspaceId">
    <summary class="subtle-link">Remove…</summary>
    <form class="detail-actions" method="post" action="/workspace/remove">
        <AntiforgeryToken />
        <input type="hidden" name="workspace_id" value="@WorkspaceId">
        <span class="muted">Removes this registration and deletes its <code>.miller</code> index data (rebuildable via <code>workspace open</code>).</span>
        <button type="submit" class="refresh-button">Confirm remove</button>
        <button type="button" class="subtle-link" data-close-details>Cancel</button>
    </form>
</details>

@code {
    [Parameter, EditorRequired] public string WorkspaceId { get; set; } = string.Empty;
}
