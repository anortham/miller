<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Miller.Indexing — infrastructure. The julie-extract subprocess wrapper, the SQLite (WAL) read layer,
    and the file watcher / single-writer indexer. Populates Miller.Core's types from the extract DB.
    Microsoft.Data.Sqlite (bundled, not .Core) auto-initializes the e_sqlite3 provider — do NOT call
    SQLitePCLRaw.Batteries_V2.Init().
  -->

  <ItemGroup>
    <PackageReference Include="Blake3" Version="2.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <!-- The contract gate (JulieSchemaGate) and version constants are internal; the contract test suite
       drives them directly. Miller.Testing needs WindowsKillOnCloseJob: CT provider processes are contained
       in the same kill-on-close job object as julie-extract scans, because Kill(entireProcessTree: true)
       walks only the LIVE child list and cannot see a grandchild whose own parent already exited. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Miller.Tests" />
    <InternalsVisibleTo Include="Miller.Testing" />
    <InternalsVisibleTo Include="miller" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Miller.Core\Miller.Core.csproj" />
  </ItemGroup>

</Project>
