{
  "schema_version": 1,
  "workloads": [
    {
      "id": "startup.leader.no_change",
      "execution_kind": "mcp_bootstrap",
      "command": ["serve"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "metadata": {"perf_row": "startup leader no-change convergence"}
    },
    {
      "id": "startup.reader.warm",
      "execution_kind": "mcp_bootstrap",
      "command": ["serve"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 5000, "windows": 10000},
      "hard_budget_memory_bytes": 629145600,
      "metadata": {"perf_row": "startup reader"}
    },
    {
      "id": "workspace.open.no_change",
      "execution_kind": "miller_cli",
      "command": ["workspace", "open", "--path", "{workspace}", "--json"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 5000, "windows": 10000},
      "hard_budget_memory_bytes": 629145600,
      "metadata": {"perf_row": "PERF-010 workspace open"}
    },
    {
      "id": "producer.retry.identical",
      "execution_kind": "julie_store",
      "command": ["store", "import", "--store", "{store_copy}", "--family", "{family}", "--root", "{workspace}", "--view", "{view}", "--level", "full", "--request-id", "perf-recovery-import", "--idempotency-key", "perf-recovery-import", "--request-timeout-seconds", "30", "--json"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "mutates_store": true,
      "isolated_snapshot": true,
      "metadata": {"perf_row": "stranded import and byte-identical retry"}
    },
    {
      "id": "producer.resolve.one_file",
      "execution_kind": "julie_store",
      "command": ["store", "resolve", "--store", "{store_copy}", "--view", "{view}", "--request-id", "perf-recovery-resolve-one-file", "--idempotency-key", "perf-recovery-resolve-one-file", "--request-timeout-seconds", "30", "--json"],
      "warmups": 0,
      "runs": 1,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 5000, "windows": 10000},
      "hard_budget_memory_bytes": 629145600,
      "mutates_store": true,
      "isolated_snapshot": true,
      "metadata": {"perf_row": "resolution/store growth one-file scope", "resolution_scope": "one_file", "changed_path": "README.md"}
    },
    {
      "id": "producer.resolve.full",
      "execution_kind": "julie_store",
      "command": ["store", "resolve", "--store", "{store_copy}", "--view", "{view}", "--request-id", "perf-recovery-resolve-full", "--idempotency-key", "perf-recovery-resolve-full", "--request-timeout-seconds", "30", "--json"],
      "warmups": 0,
      "runs": 1,
      "timeout_ms": 1253000,
      "hard_budget_ms": {"development": 60000, "windows": 120000},
      "hard_budget_memory_bytes": 629145600,
      "mutates_store": true,
      "isolated_snapshot": true,
      "metadata": {"perf_row": "resolution/store growth full scope", "resolution_scope": "full"}
    },
    {
      "id": "tool.inspect.warm",
      "execution_kind": "miller_cli",
      "command": ["inspect", "src/Miller.Server/Tools/WorkspaceTool.cs", "--depth", "overview", "--limit", "1", "--json"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 500, "windows": 2000},
      "hard_budget_memory_bytes": 629145600,
      "metadata": {"perf_row": "warm inspect"}
    },
    {
      "id": "tool.context.references.depth0",
      "execution_kind": "miller_cli",
      "command": ["context", "CLI workspace routing", "--reference-mode", "usage", "--reference-depth", "0", "--token-budget", "1200", "--max-hops", "1", "--json"],
      "warmups": 1,
      "runs": 3,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "timeout_ms": 60000,
      "semantic": false,
      "lexical_control": true,
      "metadata": {"perf_row": "context reference depth baseline", "reference_depth": 0}
    },
    {
      "id": "tool.context.references.depth1",
      "execution_kind": "miller_cli",
      "command": ["context", "CLI workspace routing", "--reference-mode", "usage", "--reference-depth", "1", "--token-budget", "1200", "--max-hops", "1", "--json"],
      "warmups": 1,
      "runs": 3,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "timeout_ms": 60000,
      "semantic": false,
      "lexical_control": true,
      "metadata": {"perf_row": "context N+1 reference work", "reference_depth": 1}
    },
    {
      "id": "tool.context.references.depth1.semantic",
      "execution_kind": "miller_cli",
      "command": ["context", "CLI workspace routing", "--reference-mode", "usage", "--reference-depth", "1", "--token-budget", "1200", "--max-hops", "1", "--json"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "semantic": true,
      "lexical_control": false,
      "metadata": {"perf_row": "context semantic-on depth one", "reference_depth": 1}
    },
    {
      "id": "tool.context.references.depth1.batch_off",
      "execution_kind": "miller_cli",
      "command": ["context", "CLI workspace routing", "--reference-mode", "usage", "--reference-depth", "1", "--token-budget", "1200", "--max-hops", "1", "--json"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "semantic": false,
      "lexical_control": true,
      "context_batch": "off",
      "metadata": {"perf_row": "context batch-off depth one", "reference_depth": 1}
    },
    {
      "id": "tool.context.references.depth1.batch_on",
      "execution_kind": "miller_cli",
      "command": ["context", "CLI workspace routing", "--reference-mode", "usage", "--reference-depth", "1", "--token-budget", "1200", "--max-hops", "1", "--json"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "parity_with": "tool.context.references.depth1.batch_off",
      "semantic": false,
      "lexical_control": true,
      "context_batch": "on",
      "metadata": {"perf_row": "context batch-on depth one", "reference_depth": 1}
    },
    {
      "id": "tool.impact.bounded",
      "execution_kind": "miller_cli",
      "command": ["impact", "src/Miller.Server/Tools/WorkspaceTool.cs", "--max-depth", "1", "--limit", "20", "--json"],
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "metadata": {"perf_row": "impact graph/query work"}
    },
    {
      "id": "tool.trace.warm",
      "execution_kind": "miller_cli",
      "command": ["trace", "{target}", "--mode", "refs", "--limit", "20", "--json"],
      "target_discovery": {"command": ["search", "WorkspaceTool", "--limit", "1", "--json"], "field": "symbol_id"},
      "warmups": 1,
      "runs": 3,
      "timeout_ms": 60000,
      "hard_budget_ms": {"development": 2000, "windows": 5000},
      "hard_budget_memory_bytes": 629145600,
      "metadata": {"perf_row": "warm trace"}
    }
  ]
}
