{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miller.local/schemas/agent-efficiency/answer-v1.json",
  "title": "Miller agent-efficiency structured answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "status", "answer", "evidence", "actions"],
  "properties": {
    "contract_id": {
      "anyOf": [
        { "type": "string", "const": "takeover-evaluation-v1" },
        { "type": "null" }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["answered", "not_found", "blocked"]
    },
    "answer": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol", "line", "claim"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "symbol": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "claim": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "actions": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/submittedAction" }
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "repoRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "actionKind": {
      "type": "string",
      "enum": [
        "inspect_symbol",
        "inspect_file",
        "assemble_context",
        "trace_callers",
        "trace_callees",
        "trace_call_path",
        "cite_reference_site",
        "select_tests",
        "propose_edit",
        "propose_rename",
        "read_log",
        "query_pattern",
        "recover_workspace",
        "report_empty",
        "refuse_unsafe"
      ]
    },
    "canonicalSymbolId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "nullableCanonicalSymbolId": {
      "anyOf": [
        { "$ref": "#/$defs/canonicalSymbolId" },
        { "type": "null" }
      ]
    },
    "referenceSiteIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line_start",
        "line_end",
        "column_start",
        "column_end",
        "reference_kind",
        "containing_symbol_id",
        "source_symbol_id",
        "target_symbol_id",
        "resolution"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/repoRelativePath" },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "column_start": { "type": ["integer", "null"], "minimum": 0 },
        "column_end": { "type": ["integer", "null"], "minimum": 0 },
        "reference_kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "containing_symbol_id": { "$ref": "#/$defs/nullableCanonicalSymbolId" },
        "source_symbol_id": { "$ref": "#/$defs/nullableCanonicalSymbolId" },
        "target_symbol_id": { "$ref": "#/$defs/nullableCanonicalSymbolId" },
        "resolution": {
          "type": "string",
          "enum": ["exact", "fallback", "unresolved"]
        }
      }
    },
    "actionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol_id",
        "target_symbol_id",
        "reference_site",
        "test_path",
        "pattern_id",
        "workspace_selector"
      ],
      "properties": {
        "path": {
          "anyOf": [
            { "$ref": "#/$defs/repoRelativePath" },
            { "type": "null" }
          ]
        },
        "symbol_id": { "$ref": "#/$defs/nullableCanonicalSymbolId" },
        "target_symbol_id": { "$ref": "#/$defs/nullableCanonicalSymbolId" },
        "reference_site": {
          "anyOf": [
            { "$ref": "#/$defs/referenceSiteIdentity" },
            { "type": "null" }
          ]
        },
        "test_path": {
          "anyOf": [
            { "$ref": "#/$defs/repoRelativePath" },
            { "type": "null" }
          ]
        },
        "pattern_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "workspace_selector": {
          "anyOf": [
            { "$ref": "#/$defs/repoRelativePath" },
            { "type": "null" }
          ]
        }
      }
    },
    "submittedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "$ref": "#/$defs/actionKind" },
        "target": { "$ref": "#/$defs/actionTarget" }
      }
    }
  }
}
