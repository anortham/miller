# .NET
bin/
!/bin/
!/bin/miller-plugin-launcher.cjs
obj/
*.user
*.suo
.vs/
*.DotSettings.user

# Rust
target/
Cargo.lock

# Models (downloaded on first run)
models/*.onnx
models/*.bin

# Index data (per-project, rebuildable)
.codesearch/
.miller/

# Downloaded tool binaries (julie-extract etc.) — fetched from julie-extractors releases at restore time, never committed
.tools/

# Local implementation worktrees
.worktrees/
.claude/worktrees/

# Soak/eval run output. Never committed, and ignoring it also keeps the indexer from converging on it:
# scripts/semantic-broker-soak.* writes JSONL here for ~30 minutes, and on a machine indexing this workspace
# those writes trigger vector convergence, which respawns a semantic broker that then owns the machine-global
# Windows pipe and silently absorbs the soak's own probes (see the foreign-broker preflight in that script).
artifacts/

# IDE
.idea/
.vscode/
.cursor/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test results and crash dumps
TestResults/

# Generated bindings (uncomment if you want to regenerate each build)
# src/Codesearch.Interop/Generated/

# Claude Code local settings (contains user-specific config)
.claude/settings.local.json
# Claude Code scheduler runtime lock (transient, machine-local)
.claude/scheduled_tasks.lock

# Codex CLI local config (user/machine-specific)
.codex/

# Generated julie extract index + logs (per-project, rebuildable)
.julie/

# SQLite transient sidecar files
*.db-wal
*.db-shm
*.db-journal

# razorback working-tree scratch (reports, progress ledger)
.razorback/

__pycache__/
