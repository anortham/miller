# .NET
bin/
!/bin/
!/bin/miller-plugin-launcher.cjs
obj/
*.user
*.suo
.vs/
*.DotSettings.user

# Rust
target/
Cargo.lock

# Models (downloaded on first run)
models/*.onnx
models/*.bin

# Index data (per-project, rebuildable)
.codesearch/
.miller/

# Downloaded tool binaries (julie-extract etc.) — fetched from julie-extractors releases at restore time, never committed
.tools/

# Local implementation worktrees
.worktrees/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Generated bindings (uncomment if you want to regenerate each build)
# src/Codesearch.Interop/Generated/

# Claude Code local settings (contains user-specific config)
.claude/settings.local.json
# Claude Code scheduler runtime lock (transient, machine-local)
.claude/scheduled_tasks.lock

# Codex CLI local config (user/machine-specific)
.codex/

# Generated julie extract index + logs (per-project, rebuildable)
.julie/

# SQLite transient sidecar files
*.db-wal
*.db-shm
*.db-journal
