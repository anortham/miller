<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="miller"><HintPath>$(MillerBinaries)/miller.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.core"><HintPath>$(MillerBinaries)/SQLitePCLRaw.core.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2"><HintPath>$(MillerBinaries)/SQLitePCLRaw.batteries_v2.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3"><HintPath>$(MillerBinaries)/SQLitePCLRaw.provider.e_sqlite3.dll</HintPath></Reference>
    <Reference Include="Miller.Indexing"><HintPath>$(MillerBinaries)/Miller.Indexing.dll</HintPath></Reference>
    <Reference Include="Miller.Core"><HintPath>$(MillerBinaries)/Miller.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Data.Sqlite"><HintPath>$(MillerBinaries)/Microsoft.Data.Sqlite.dll</HintPath></Reference>
    <None Include="$(MillerBinaries)/*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Include="$(MillerBinaries)/runtimes/**/*" CopyToOutputDirectory="PreserveNewest" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
