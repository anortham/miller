<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing standalone apps, so they require OutputType=Exe.
         dotnet test still drives them via Microsoft.NET.Test.Sdk + xunit.runner.visualstudio (VSTest mode). -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Default the test run to the FAST suite: exclude [Trait("Category","Scale")] tests (which spawn the
         real julie-extract or build large fixtures). VSTestTestCaseFilter is the MSBuild equivalent of the
         test runner's filter flag, so a bare run executes ONLY the fast suite (the dev-loop default), while
         passing an explicit filter on the command line OVERRIDES this (e.g. "Category=Scale" runs the Scale
         suite). This is the primary defense against the slow-suite-by-default trap that left julie's suite at
         30+ minutes. (A well-formed .runsettings <TestCaseFilter> works too, but this single MSBuild property
         needs no extra file and fails the build LOUDLY on a typo, whereas a malformed runsettings is silently
         ignored and runs everything.) -->
    <VSTestTestCaseFilter>Category!=Scale</VSTestTestCaseFilter>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- Tests synthesize the julie-schema DB directly (explicit, not transitive). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- The CallToolFilter pin stands up an in-process MCP client+server (explicit, not transitive). -->
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <!-- In-memory HTTP tests for the dashboard's antiforgery-validated mutation endpoints (ADR-0002). -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Miller.SharedBrokerTestHost/Miller.SharedBrokerTestHost.csproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="../../eval/semantic-model-eval/Miller.SemanticModelEval.csproj" />
    <ProjectReference Include="../../src/Miller.Core/Miller.Core.csproj" />
    <ProjectReference Include="../../src/Miller.Dashboard/Miller.Dashboard.csproj" />
    <ProjectReference Include="../../src/Miller.Indexing/Miller.Indexing.csproj" />
    <ProjectReference Include="../../src/Miller.Server/Miller.Server.csproj" />
    <ProjectReference Include="../../src/Miller.Testing/Miller.Testing.csproj" />
    <ProjectReference Include="../../scripts/Miller.PackageSemanticSmoke/Miller.PackageSemanticSmoke.csproj" />
    <ProjectReference Include="../../scripts/Miller.SemanticBrokerProbe/Miller.SemanticBrokerProbe.csproj" />
    <ProjectReference Include="../../tools/Miller.SearchQuality/Miller.SearchQuality.csproj" />
  </ItemGroup>
</Project>
